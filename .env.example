# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Example:
# SERVERVAR="foo"
# NEXT_PUBLIC_CLIENTVAR="bar"

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL="https://footfactor.com"
# Set to any value to skip env validation in src/env.js (e.g. Docker builds)
# SKIP_ENV_VALIDATION=1

# ---------------------------------------------------------------------------
# Prismic
# ---------------------------------------------------------------------------
# Repository name (falls back to slicemachine.config.json if unset)
NEXT_PUBLIC_PRISMIC_ENVIRONMENT=""
# Only needed for the scripts in /migration
PRISMIC_WRITE_TOKEN=""

# ---------------------------------------------------------------------------
# Algolia (search)
# ---------------------------------------------------------------------------
ALGOLIA_ADMIN_KEY=""
NEXT_PUBLIC_ALGOLIA_APPLICATION_ID=""
NEXT_PUBLIC_ALGOLIA_SEARCH_ONLY_API_KEY=""

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# Which provider to use: "MAILERSEND" (default) or "BREVO"
MAILER="MAILERSEND"
MAILERSEND_API_KEY=""
MAILERSEND_DOMAIN=""
BREVO_API_KEY=""
BREVO_DOMAIN=""

# ---------------------------------------------------------------------------
# Bot protection
# ---------------------------------------------------------------------------
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ---------------------------------------------------------------------------
# Google
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=""
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
